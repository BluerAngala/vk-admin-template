{
  "bsonType": "object",
  "required": ["user_id", "product_id"],
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "title": "用户ID",
      "description": "购买用户的ID",
      "foreignKey": "uni-id-users._id"
    },
    "product_id": {
      "bsonType": "string",
      "title": "产品ID",
      "description": "购买的产品ID"
    },
    "product_record_id": {
      "bsonType": "string",
      "title": "产品记录ID",
      "description": "购买的产品记录_id（产品的_id，用于精确匹配）"
    },
    "product_name": {
      "bsonType": "string",
      "title": "产品名称",
      "description": "购买时的产品名称"
    },
    "price_paid": {
      "bsonType": "int",
      "title": "支付积分",
      "description": "实际支付的积分数",
      "minimum": 0
    },
    "buy_time": {
      "bsonType": "timestamp",
      "title": "购买时间",
      "description": "购买时间戳"
    },
    "_add_time": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}

