{
  "bsonType": "object",
  "required": ["config_key"],
  "permission": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "config_key": {
      "bsonType": "string",
      "title": "配置项标识",
      "description": "唯一标识，如 landing-features、landing-advantages",
      "trim": "both",
      "permission": {
        "read": true
      }
    },
    "config_name": {
      "bsonType": "string",
      "title": "配置项名称",
      "description": "显示名称",
      "permission": {
        "read": true
      }
    },
    "config_value": {
      "bsonType": "object",
      "title": "配置值",
      "description": "JSON 格式的配置数据",
      "permission": {
        "read": true
      }
    },
    "enable": {
      "bsonType": "boolean",
      "title": "是否启用",
      "defaultValue": true,
      "permission": {
        "read": true
      }
    },
    "_add_time": {
      "description": "创建时间",
      "permission": {
        "read": true
      }
    },
    "_update_time": {
      "description": "修改时间",
      "permission": {
        "read": true
      }
    }
  }
}
