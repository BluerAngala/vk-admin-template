{
  "bsonType": "object",
  "description": "充值订单表",
  "required": ["user_id", "trade_no", "status"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID",
      "title": "用户ID"
    },
    "trade_no": {
      "bsonType": "string",
      "description": "交易单号",
      "title": "交易单号"
    },
    "package_id": {
      "bsonType": "int",
      "description": "套餐ID",
      "title": "套餐ID"
    },
    "package_name": {
      "bsonType": "string",
      "description": "套餐名称",
      "title": "套餐名称"
    },
    "points": {
      "bsonType": "int",
      "description": "基础积分",
      "title": "基础积分"
    },
    "bonus": {
      "bsonType": "int",
      "description": "赠送积分",
      "title": "赠送积分"
    },
    "price": {
      "bsonType": "int",
      "description": "支付金额（分）",
      "title": "支付金额"
    },
    "goods_key": {
      "bsonType": "string",
      "description": "支付平台商品key",
      "title": "商品Key"
    },
    "payurl": {
      "bsonType": "string",
      "description": "支付链接",
      "title": "支付链接"
    },
    "status": {
      "bsonType": "string",
      "description": "订单状态",
      "title": "状态",
      "enum": [
        { "value": "pending", "text": "待支付" },
        { "value": "success", "text": "充值成功" },
        { "value": "failed", "text": "充值失败" },
        { "value": "cancelled", "text": "已取消" }
      ]
    },
    "fail_reason": {
      "bsonType": "string",
      "description": "失败原因",
      "title": "失败原因"
    },
    "retry_count": {
      "bsonType": "int",
      "description": "重试次数",
      "title": "重试次数"
    },
    "_add_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "title": "创建时间"
    },
    "_update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "title": "更新时间"
    }
  }
}
