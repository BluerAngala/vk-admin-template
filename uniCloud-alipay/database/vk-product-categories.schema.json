{
  "bsonType": "object",
  "required": ["value", "label", "sort"],
  "permission": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "value": {
      "bsonType": "string",
      "title": "分类标识",
      "description": "英文唯一标识，如 software、plugin",
      "trim": "both",
      "permission": {
        "read": true
      }
    },
    "label": {
      "bsonType": "string",
      "title": "分类名称",
      "description": "显示名称，如 软件、浏览器插件",
      "trim": "both",
      "permission": {
        "read": true
      }
    },
    "icon": {
      "bsonType": "string",
      "title": "图标",
      "description": "Element UI 图标类名",
      "permission": {
        "read": true
      }
    },
    "sort": {
      "bsonType": "number",
      "title": "排序",
      "description": "数值越小越靠前",
      "defaultValue": 0,
      "permission": {
        "read": true
      }
    },
    "enable": {
      "bsonType": "boolean",
      "title": "是否启用",
      "description": "false 则前端不显示该分类",
      "defaultValue": true,
      "permission": {
        "read": true
      }
    },
    "_add_time": {
      "description": "创建时间",
      "permission": {
        "read": true
      }
    },
    "_update_time": {
      "description": "修改时间",
      "permission": {
        "read": true
      }
    }
  }
}
